# Vazio = mesma origem (o nginx do frontend faz proxy do /api para o backend).
# Recomendado para produção; assim funciona em qualquer máquina, sem IP fixo.
# Use uma URL completa apenas quando servir o frontend sem o proxy (ex.: dev local).
VITE_API_URL=

# Pasta no HOST com a coleção de MP3 (montada somente leitura)
MUSIC_PATH=/caminho/para/suas/musicas

# Diretório no HOST para o banco de dados SQLite (playlists + índice)
SONARIS_DATA_DIR=/caminho/para/sonaris/database

# Portas expostas no HOST
BACKEND_PORT=5033
FRONTEND_PORT=3003

# --- Autenticação / JWT ---
# IMPORTANTE: defina um valor longo e aleatório (ex.: gere com `openssl rand -base64 64`).
# O backend se recusa a iniciar sem um JWT_SECRET.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_ISSUER=sonaris
JWT_AUDIENCE=sonaris
JWT_EXPIRA_EM_MINUTOS=1440

# --- Conta de administrador criada na primeira execução ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NOME=Administrador
